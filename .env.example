# Local OpenAI-compatible llama.cpp server (started by ./start-nemo.sh)
NEMO_BASE_URL=http://127.0.0.1:8080/v1
# Model id sent to the server. Defaults to the selected GGUF's file name.
# NEMO_MODEL=Qwen3.5-4B-Q4_K_M
NEMO_API_KEY=local
NEMO_MAX_TOKENS=4096
NEMO_MAX_CONTINUATIONS=2
NEMO_TOOL_ROUNDS=32
NEMO_TASK_TOKENS=16384
NEMO_TASK_TIMEOUT_SECS=900
NEMO_PERMISSION=trusted
NEMO_TEMPERATURE=0.6
NEMO_TOP_P=0.95
NEMO_TOP_K=20
NEMO_SEED=-1
# Thinking is off by default: small models call tools more reliably without it.
NEMO_THINKING=off
# Paths are literal values; shell substitutions and ~ are not expanded.
# NEMO_WORKSPACE=/absolute/path/to/project
# NEMO_SESSION_DIR=/absolute/path/to/session
# NEMO_CONFIG=/absolute/path/to/nemocode.env
# Total prompt token budget (messages + tool schemas).
# Default: NEMO_CTX - NEMO_MAX_TOKENS - 512.
# Keep this below llama-server --ctx-size (NEMO_CTX). On overflow NemoCode auto-compacts and retries.
# NEMO_CONTEXT_BUDGET=11776
# NEMO_CTX=16384
# Abort if the model SSE stream stalls with no chunks (seconds). 0 = wait forever.
NEMO_SSE_IDLE_TIMEOUT_SECS=300

# Python LSP (diagnostics only). auto = basedpyright/pyright on PATH; off = disable;
# or set a full command / binary path. No network needed once installed.
NEMO_PYTHON_LSP=auto
# NEMO_PYTHON_LSP_COMMAND=basedpyright-langserver --stdio

# Optional launcher overrides for ./start-nemo.sh
# Model size: auto picks by RAM/VRAM. mini 1.3 GB, small 2.7 GB, medium 5.7 GB,
# large 16.5 GB, nemotron = the original NemoCode model,
# gemma4 = experimental Gemma 4 coding-agent model (5.34 GB).
# NEMO_MODEL_PRESET=auto
# NEMO_MODEL_REPO=owner/some-model-GGUF
# NEMO_MODEL_FILE=some-model-Q4_K_M.gguf
# NEMO_MODEL_PATH=/absolute/path/to/model.gguf
# NEMO_SERVER_START_TIMEOUT=300
# NEMO_MODELS_DIR=./models
# NEMO_HOST=127.0.0.1
# NEMO_PORT=8080
# NEMO_CTX=16384
# NEMO_GPU_LAYERS=auto
# NEMO_FIT=on
# NEMO_THREADS=8
# NEMO_PARALLEL=1
# NEMO_FLASH_ATTN=on
# NEMO_BATCH=2048
# NEMO_UBATCH=512
# NEMO_CACHE_TYPE_K=q8_0
# NEMO_CACHE_TYPE_V=q8_0
# NEMO_MLOCK=1
# NEMO_LLAMA_SERVER=/path/to/llama-server
# NEMO_LLAMA_BACKEND=cpu
# NEMO_LLAMA_RELEASE=b10043
# NEMO_VENDOR_DIR=./.vendor/llama.cpp
# NEMO_MODEL_REVISION=main
# NEMO_MODEL_SHA256=expected-sha256-from-a-trusted-source
# NEMO_IDLE_TIMEOUT_SECS=0
# NEMO_ATTACH=1
# NEMO_CLI=/absolute/path/to/nemocode
