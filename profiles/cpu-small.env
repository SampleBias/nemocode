# Initial CPU profile; measure on the target device before deployment.
NEMO_GPU_LAYERS=0
NEMO_LLAMA_BACKEND=cpu
NEMO_CTX=8192
NEMO_MAX_TOKENS=1024
NEMO_TASK_TOKENS=8192
NEMO_THREADS=2
NEMO_BATCH=256
NEMO_UBATCH=64
NEMO_PARALLEL=1
NEMO_FLASH_ATTN=auto
NEMO_CACHE_TYPE_K=q8_0
NEMO_CACHE_TYPE_V=q8_0
NEMO_PYTHON_LSP=off
NEMO_IDLE_TIMEOUT_SECS=120
